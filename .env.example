# Copy to .env.local and adjust. All NEXT_PUBLIC_* values ship to the client.
NEXT_PUBLIC_SITE_URL=https://thecryptotools.com
# Master switch for our own AdSense units (Auto ads load via the AdSense script regardless).
NEXT_PUBLIC_ENABLE_ADS=false
# AdSense publisher id (public — appears in the page source).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# Google Analytics 4 measurement id (public).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
