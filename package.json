{
  "name": "cryptotoolkit",
  "version": "0.1.0",
  "private": true,
  "description": "CryptoToolkit — free crypto utilities platform with 100+ trading, AI and developer tools. Config-driven, SEO-first, infinitely scalable.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-og.mjs && node scripts/generate-llms.mjs && node scripts/generate-404.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "history": "node scripts/generate-history.mjs",
    "unlocks": "node scripts/generate-unlocks.mjs",
    "halvings": "node scripts/generate-halvings.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run --no-build",
    "deploy:selftest": "node scripts/deploy.mjs --selftest --no-build"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
