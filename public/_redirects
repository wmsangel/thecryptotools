# ============================================================================
# Cloudflare Pages — redirects. Ported from public/.htaccess.
# ============================================================================
# Everything in public/ is copied verbatim into out/ by the Next export, so
# this file ships at the site root where Pages reads it.
#
# Format:  <source>  <destination>  <status>
# First match wins. `*` is a wildcard; `:splat` is what it captured.
# A source WITHOUT a wildcard matches that exact path only.

# --- Canonical host: force non-www --------------------------------------------
# NOT handled here. Cloudflare Pages matches _redirects sources by PATH only, so
# a host-based source (https://www.…/*) never fires — www would serve 200 and
# duplicate the apex. www → apex 301 is done by a zone-level Redirect Rule in the
# Cloudflare dashboard instead (Rules → Redirect Rules, "www to apex":
# http.host eq "www.thecryptotools.com" → concat("https://thecryptotools.com",
# http.request.uri.path), 301, preserve query). Keep that rule, not a line here.

# --- /embed and /embed/ → /widgets/ -------------------------------------------
# Was: RedirectMatch 301 ^/embed/?$ /widgets/. Only the bare directory root
# redirects; individual widgets at /embed/<tool>/ are NOT matched (no wildcard)
# and keep serving 200.
/embed   /widgets/  301
/embed/  /widgets/  301

# --- Guessed tool slugs → real tool ------------------------------------------
# Top Bing query is "fake crypto wallet simulator"; visitors guess that slug
# (seen as 404 in CF edge stats, 2026-09-26). Real tool: /tools/fake-wallet-generator/.
/tools/fake-crypto-wallet-simulator   /tools/fake-wallet-generator/  301
/tools/fake-crypto-wallet-simulator/  /tools/fake-wallet-generator/  301
# Seen as 404 in CF edge stats, 2026-09-29. Real tool: /tools/bitcoin-halving-countdown/.
/tools/halving-countdown   /tools/bitcoin-halving-countdown/  301
/tools/halving-countdown/  /tools/bitcoin-halving-countdown/  301

# --- /go affiliate redirects: NOT here -----------------------------------------
# /go/<id> is served by the Pages Function functions/go/[[path]].js (gesture gate
# + signed click-time token; destinations in src/lib/go-map.generated.json, built
# by scripts/build-go-redirects.ts from platforms.ts). A static /go/* rule in this
# file would run BEFORE the function and bypass the gate, so none may be added —
# the build fails if one appears. Manual offers (2ndnumber, ishosting, protonvpn,
# expressvpn) live in EXTRA inside that script.

